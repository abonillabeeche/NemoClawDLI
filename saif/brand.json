      "min": 0
    },
    {
      "from": "#4f7f00",
      "to": "#1F8A5B",
      "min": 0
    }
  ],
  "text": [
    {
      "from": "NVIDIA DLI · ",
      "to": "SAIF · ",
      "min": 2
    },
    {
      "from": ">NVIDIA · Securing Agents<",
      "to": ">SAIF · Securing Agents<",
      "min": 8
    },
    {
      "from": "<span class=\"logo\">NVIDIA DLI</span>",
      "to": "<span class=\"logo\">SAIF</span>",
      "min": 1
    },
    {
      "from": "https://www.nvidia.com/en-us/learn/training/support/",
      "to": "https://github.com/abonillabeeche/NemoClawDLI/issues",
      "min": 1
    },
