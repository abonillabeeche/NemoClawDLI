{
  "name": "SAIF",
  "long_name": "SUSE AI Factory",
  "note": "Applied to the BUILT site (public/), never to source, so syncing upstream main stays conflict-free. Each rule's `min` is the fewest hits expected across the whole site; the script fails when upstream drifts below it so we notice instead of shipping half-branded pages.",
  "skip_dirs": [
    "vendor",
    ".git"
  ],
  "extensions": [
    ".html",
    ".js",
    ".mjs",
    ".css",
    ".svg",
    ".json"
  ],
  "colors": [
